# 全部变量带 ATOMMEM_ 前缀；
# sqlite 单文件（默认）；
ATOMMEM_DATABASE_URL=sqlite:///./atom_memory.db

# 固化/召回所用 LLM（OpenAI 兼容端点）
ATOMMEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
ATOMMEM_LLM_API_KEY=EMPTY
ATOMMEM_LLM_MODEL=your-model-name
# 单次 /chat/completions 超时秒数（经代理访问大模型建议 600+）
ATOMMEM_LLM_TIMEOUT_SECONDS=600
# true=使用系统 HTTP(S)_PROXY；直连模型时可设 false
ATOMMEM_LLM_TRUST_ENV=true
# Qwen3 / vLLM：false=extra_body 关闭思考（更快）；true=开启
ATOMMEM_LLM_ENABLE_THINKING=false
# 可选，额外并入请求体的 JSON 对象
# ATOMMEM_LLM_EXTRA_BODY_JSON={"top_k":20}

# 设置后所有请求须带 X-API-Key；留空不鉴权
ATOMMEM_API_KEY=

# 向量召回（Qwen3-Embedding；api_base 留空则关闭 embedding/hybrid）
# ATOMMEM_EMBEDDER_API_BASE=http://10.2.2.132:8000/v1
# ATOMMEM_EMBEDDER_API_KEY=EMPTY
# ATOMMEM_EMBEDDER_MODEL=emd
ATOMMEM_EMBEDDER_API_BASE=
ATOMMEM_EMBEDDER_API_KEY=EMPTY
ATOMMEM_EMBEDDER_MODEL=
ATOMMEM_EMBEDDER_TIMEOUT_SECONDS=60
ATOMMEM_EMBEDDER_TRUST_ENV=true
ATOMMEM_EMBED_DETAIL_CHARS=200

# /chat 可选联网搜索（DashScope WebSearch MCP SSE）
ATOMMEM_DASHSCOPE_API_KEY=
ATOMMEM_WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
