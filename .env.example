# 全部变量带 ATOMMEM_ 前缀；见 atom_memory/config.py

# sqlite 单文件（默认）；换 Postgres:
# ATOMMEM_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/atom_memory
ATOMMEM_DATABASE_URL=sqlite:///./atom_memory.db

# 固化/召回所用 LLM（OpenAI 兼容端点）
ATOMMEM_LLM_BASE_URL=http://127.0.0.1:8000/v1
ATOMMEM_LLM_API_KEY=EMPTY
ATOMMEM_LLM_MODEL=your-model-name

# 设置后所有请求须带 X-API-Key；留空不鉴权
ATOMMEM_API_KEY=

# /chat 可选联网搜索（DashScope WebSearch MCP SSE）
ATOMMEM_DASHSCOPE_API_KEY=
ATOMMEM_WEB_SEARCH_MCP_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
